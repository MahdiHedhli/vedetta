# ============================================
# Vedetta .gitignore — Security-First Defaults
# ============================================
# Rule: when in doubt, exclude it. It's easier
# to explicitly include a file than to scrub
# a secret from git history.
# ============================================

# ----- Internal / Private -----
# Local-only workspace for credentials, strategy
# docs, PII, testing configs, and anything that
# should never touch a remote.
/internal/
/internal-*/
/internal_*/
/internal.*/
/private/
/private-*/
/private_*/
/private.*/

# ----- Secrets & Credentials -----
# Dotenv files and named variants must stay ignored case-independently.
# The already-tracked root `.env.example` remains usable; new templates need
# an explicit force-add followed by the repository sanitation gate.
# This protects files containing GITHUB_PAT and other secrets.
# Confirmed present before any recovery commits.
.[eE][nN][vV]*
*.[eE][nN][vV]
*.[eE][nN][vV].*
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
*.truststore
credentials.*
secrets.*
*secret*
*.token
*.tokens
token.txt
token.json
auth-token.txt
!*_test.go
service-account*.json
gcp-credentials*.json
aws-credentials*
.aws/
.aws-*/
.aws_*/
.aws.*/
.gcp/
.gcp-*/
.gcp_*/
.gcp.*/
kubeconfig
*.tfstate
*.tfstate.backup
.terraform/
.terraform-*/
.terraform_*/
.terraform.*/

# ----- API Keys & Config Overrides -----
config.local.*
config.prod.*
config.staging.*
*.local.yml
*.local.yaml
*.local.json
*.local.toml

# ----- macOS -----
.DS_Store
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
Icon?

# ----- Windows -----
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ----- Linux -----
*~
.nfs*

# ----- Go -----
*.exe
*.dll
*.so
*.dylib
*.test
*.out
vendor/
/backend/vedetta
/telemetry/telemetry
/threat-network/threat-network
/scripts/simulate/simulate

# ----- Node / Frontend -----
node_modules/
frontend/dist/
.npm
.yarn/
.pnp.*

# ----- IDE -----
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project
*.code-workspace
.project
.settings/
.classpath

# ----- Python tooling -----
__pycache__/
*.py[cod]

# ----- Data & Databases -----
*.db
*.sqlite
*.sqlite3
*.db3
*.s3db
*.sl3
*.sqlite3-wal
*.sqlite3-wal.*
*.sqlite3-shm
*.sqlite3-shm.*
*.sqlite3-journal
*.sqlite3-journal.*
*.db3-wal
*.db3-wal.*
*.db3-shm
*.db3-shm.*
*.db3-journal
*.db3-journal.*
*.s3db-wal
*.s3db-wal.*
*.s3db-shm
*.s3db-shm.*
*.s3db-journal
*.s3db-journal.*
*.sl3-wal
*.sl3-wal.*
*.sl3-shm
*.sl3-shm.*
*.sl3-journal
*.sl3-journal.*
*.db-wal
*.db-wal.*
*.db-shm
*.db-shm.*
*.db-journal
*.db-journal.*
*.sqlite-wal
*.sqlite-wal.*
*.sqlite-shm
*.sqlite-shm.*
*.sqlite-journal
*.sqlite-journal.*
*.db.*
*.sqlite.*
*.sqlite3.*
*.db3.*
*.s3db.*
*.sl3.*
data/
# ...but this data/ file is an embedded SOURCE file (//go:embed in
# threat-network/internal/store/allowlist.go), not runtime data. It MUST be
# tracked or fresh-clone builds (CI, Docker, cloud-init) fail. Re-include it.
!threat-network/internal/store/data/
!threat-network/internal/store/data/allowlist.txt
# Same rule for the embedded IEEE OUI table (//go:embed in
# backend/internal/fingerprint/oui_ieee.go). Source asset, not runtime data.
!backend/internal/fingerprint/data/
!backend/internal/fingerprint/data/oui.csv

# ----- Docker -----
docker-compose.override.yml
.docker/
.docker-*/
.docker_*/
.docker.*/

# ----- Logs -----
*.log
logs/
logs-*/
logs_*/
logs.*/
# ...but the UniFi collector test corpus ships SYNTHETIC syslog inputs as *.log
# fixtures (RFC 5737 doc IPs, example MACs, placeholder hostnames — no real
# network data). The Lua golden suite (collector/test/run_tests.lua) reads them,
# so they MUST be tracked or the suite fails on a clean checkout (issue #40).
!specs/001-unifi-log-ingestion/corpus/inputs/*.log

# ----- Network / Lab Artifacts -----
# Raw captures, browser exports, event streams, scanner output, and host dumps
# can contain device identifiers even when they do not contain credentials.
*.pcap
*.pcapng
*.cap
*.pcap.*
*.pcapng.*
*.cap.*
*.har
*.har.*
*.ndjson
*.jsonl
*.nmap
*.gnmap
*.etl
*.evtx
*.dmp
*.log.*
*.dump
*.bak
*.backup
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
captures/
capture/
exports/
export/
captures.*/
capture.*/
exports.*/
export.*/
# `export` is also the name of telemetry's application-source package. Keep
# everything in that directory ignored by default, then re-include only direct
# Go source; the sanitation gate independently requires the exact lowercase
# `.go` suffix and a regular file mode.
!telemetry/internal/export/
telemetry/internal/export/**
!telemetry/internal/export/*.go
captures-*/
captures_*/
capture-*/
capture_*/
exports-*/
exports_*/
export-*/
export_*/
inventory-*/
inventory_*/
inventory.*/
inventory/
inventories/
inventories-*/
inventories_*/
inventories.*/
backup/
backups/
backup-*/
backup_*/
backup.*/
backups-*/
backups_*/
backups.*/
dump/
dumps/
dump-*/
dump_*/
dump.*/
dumps-*/
dumps_*/
dumps.*/
scan/
scans/
scan-*/
scan_*/
scan.*/
scans-*/
scans_*/
scans.*/
pcap/
pcaps/
pcap-*/
pcap_*/
pcap.*/
pcaps-*/
pcaps_*/
pcaps.*/
packet-capture/
packet-captures/
packet-capture-*/
packet-capture_*/
packet-capture.*/
packet-captures-*/
packet-captures_*/
packet-captures.*/

