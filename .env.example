# Vedetta Environment Variables
# Copy to .env and fill in your values. Never commit .env itself.

# Backend
# VEDETTA_PORT is the port Core listens on INSIDE the container — leave it 8080.
# The port published on the HOST is VEDETTA_BACKEND_PORT below; do not confuse them.
VEDETTA_PORT=8080
VEDETTA_DB_PATH=/data/vedetta.db
VEDETTA_FRONTEND_DIR=/frontend

# Optional signed device-fingerprint database updates. Disabled means no update
# network calls and the embedded OUI baseline remains authoritative. When enabled,
# Core verifies the release signature and complete bundle before atomically switching
# generations under the persistent /data volume.
VEDETTA_DB_UPDATE_ENABLED=false
VEDETTA_DB_UPDATE_INTERVAL=24h
VEDETTA_DB_UPDATE_REPO=MahdiHedhli/vedetta
# Host installs must also set VEDETTA_DB_UPDATE_INSTALL_DIR to a writable,
# persistent generation-pointer path. Compose supplies /data/device-db/current.
VEDETTA_DB_UPDATE_INSTALL_DIR=

# Read-only dashboard release notices. On by default; set
# VEDETTA_UPDATE_CHECK_ENABLED=false to stop Core from polling the public GitHub
# releases API. This is independent of the signed device-database updater above
# and never installs an update.
VEDETTA_UPDATE_CHECK_ENABLED=true
VEDETTA_UPDATE_CHECK_INTERVAL=6h
VEDETTA_UPDATE_CHECK_REPO=MahdiHedhli/vedetta

# Optional comma-separated IPs/CIDRs for the immediate, controlled reverse-proxy
# hops that Core may trust for X-Forwarded-For/X-Real-IP. Leave blank unless you
# have followed docs/reverse-proxy.md; trusting client/LAN ranges is unsafe.
VEDETTA_TRUSTED_PROXIES=

# Network Scanning
VEDETTA_SCAN_CIDR=192.168.1.0/24
VEDETTA_SCAN_INTERVAL=5m
VEDETTA_SCAN_PORTS=false

# --- Host ports (what docker-compose.yml publishes on the HOST) ---
# scripts/gen-env.sh PROBES these at setup time and, if a default is already in
# use on the host, rewrites the value here to the next free port — so a fresh
# `docker compose up` starts cleanly even when 8080/3107/5140 are taken. It also
# prints the final URLs. Container-internal ports never change; only the host side
# does. If you edit these by hand, keep bookmarks and your firewall's syslog
# export target in sync.
# Values must be distinct for backend/frontend TCP and each must be 1..65535.
#
# Core API host port (loopback-only). Dashboard/API default: http://localhost:8080.
VEDETTA_BACKEND_PORT=8080
# Dashboard host port (loopback-only). Default: http://localhost:3107.
VEDETTA_FRONTEND_PORT=3107
# Collector syslog host port (LAN-reachable UDP — firewalls export logs here).
VEDETTA_COLLECTOR_PORT=5140

# Machine credentials. VEDETTA_INGEST_TOKEN and VEDETTA_CORE_TOKEN MUST be TWO
# DISTINCT strong secrets — generate each independently, e.g.:
#   VEDETTA_INGEST_TOKEN=$(openssl rand -hex 32)
#   VEDETTA_CORE_TOKEN=$(openssl rand -hex 32)
# They are provisioned as different scopes (ingest vs read) and are matched by
# hash: if you set them to the SAME value, only one scope is created and the
# other client gets 403 (Core logs a loud WARNING and reports it in /status).
#
# Collector ingest auth (ingest scope): Core provisions it as an ingest-scope
# token on startup and the collector presents the same value, so UniFi/firewall
# ingestion keeps authenticating once any token exists. Leave blank only for a
# Core with no tokens at all.
VEDETTA_INGEST_TOKEN=
# Telemetry read auth (read scope): Core provisions it as a read-scope token on
# startup and the telemetry daemon presents the same value to poll Core's read
# endpoints (GET /api/v1/events, /settings/telemetry). Leave blank only for a
# Core with no admin token. MUST differ from VEDETTA_INGEST_TOKEN above.
VEDETTA_CORE_TOKEN=

# Optional DNS integrations (blank URL = disabled)
# Pi-hole v6: set the base URL (for example http://pi.hole) and use a dedicated
# application password from Pi-hole Settings as TOKEN. Vedetta exchanges it for
# a short-lived session and never puts the password in the query URL. A regular
# Pi-hole password also works. If Pi-hole has no password, TOKEN may stay blank.
# Legacy v5 remains supported: URL may be the host or full /admin/api.php path,
# and TOKEN is the v5 static API token.
VEDETTA_PIHOLE_URL=
VEDETTA_PIHOLE_TOKEN= # gitleaks:allow - intentionally blank example value
VEDETTA_PIHOLE_INTERVAL=60s

# AdGuard Home uses /control/querylog and optional HTTP Basic authentication.
VEDETTA_ADGUARD_URL=
VEDETTA_ADGUARD_USER=
VEDETTA_ADGUARD_PASS=
VEDETTA_ADGUARD_INTERVAL=60s

# Optional experimental UniFi REST enrichment (client inventory + IPS events).
# Syslog/CEF ingestion works independently. Prefer a read-only API key. Set TLS
# skip-verify only when you explicitly accept the controller's self-signed cert.
VEDETTA_UNIFI_HOST=
VEDETTA_UNIFI_PORT=443
VEDETTA_UNIFI_USER=
VEDETTA_UNIFI_PASS=
VEDETTA_UNIFI_API_KEY=
VEDETTA_UNIFI_TLS_SKIP_VERIFY=false

# Telemetry: ON by default (opt-out). Contributes privacy-reduced, pseudonymous
# (not anonymous), advisory-only threat signals to the community feed — no source
# IPs/MACs/hostnames ever leave your network (see PRIVACY.md). Opt out by setting
# this to exactly "false".
# The telemetry setting can also be changed at runtime from the dashboard, which persists
# it as a Core setting that WINS over this env var (GET/PUT
# /api/v1/settings/telemetry). This env value is the fallback used only when no
# setting has been persisted.
VEDETTA_TELEMETRY_OPTIN=true
# Public community feed (matches docker-compose.yml). The local threat-network
# service is profile-disabled by default and runs off-node in production.
VEDETTA_THREAT_NETWORK_URL=https://feed.vedettas.com
VEDETTA_COMMUNITY_FEED_ENABLED=true
# Threat Network Backend
THREAT_NETWORK_PORT=9090
