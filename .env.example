# Vedetta Environment Variables
# Copy to .env and fill in your values. Never commit .env itself.

# Backend
VEDETTA_PORT=8080
VEDETTA_DB_PATH=/data/vedetta.db
VEDETTA_FRONTEND_DIR=/frontend

# Network Scanning
VEDETTA_SCAN_CIDR=192.168.1.0/24
VEDETTA_SCAN_INTERVAL=5m
VEDETTA_SCAN_PORTS=false
VEDETTA_FRONTEND_PORT=3000

# Collector ingest auth: a strong shared secret (e.g. `openssl rand -hex 32`).
# Core provisions it as an ingest-scope token on startup and the collector
# presents the same value, so UniFi/firewall ingestion keeps authenticating once
# any token exists. Leave blank only for a Core with no tokens at all.
VEDETTA_INGEST_TOKEN=

# Pi-hole Integration
PIHOLE_API_URL=http://pi.hole/admin/api.php
PIHOLE_API_TOKEN=

# Telemetry: ON by default. Contributes anonymized, advisory-only threat signals
# to the community feed — no source IPs/MACs/hostnames ever leave your network
# (see PRIVACY.md). Opt out by setting this to exactly "false".
VEDETTA_TELEMETRY_OPTIN=true
VEDETTA_THREAT_NETWORK_URL=http://threat-network:9090
VEDETTA_INSTALL_SALT=

# Threat Network Backend
THREAT_NETWORK_PORT=9090
